{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "ZeroBook Desktop — local shell + ZeroBook's own tenant pages may use IPC (SQLite mirror, secure token, updater).",
  "windows": ["main"],
  "remote": {
    "urls": [
      "https://*.zerobook.io",
      "https://*.zerobook.local",
      "http://localhost:*",
      "http://127.0.0.1:*"
    ]
  },
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close",
    "dialog:default",
    "process:default",
    "updater:default"
  ]
}
